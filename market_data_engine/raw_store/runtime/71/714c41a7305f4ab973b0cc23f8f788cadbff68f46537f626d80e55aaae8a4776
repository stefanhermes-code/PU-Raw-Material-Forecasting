	<script type="text/javascript">
		$(function(){
            $('.date').each(function (){
                var text = $(this).text();
                // 时间转化的方法
                $(this).text(moment(text).format('MMM D, YYYY'))
            })
			// Trending Topics - 缩略图轮播
			var $thumbs = $('.thumbsSwiper .swiper-slide');
			var topicIndex = 0;
			var topicTimer = null;

			var thumbsSwiper = new Swiper('.thumbsSwiper', {
				slidesPerView: 'auto',
				spaceBetween: 10,
				loop: false,
				navigation: {
					nextEl: '.thumbsSwiper .swiper-button-next',
					prevEl: '.thumbsSwiper .swiper-button-prev',
				},
				on: {
					slideChange: function () {
						// 箭头滚动缩略图条时同步激活态与大图
						setTopicActive(this.activeIndex, false);
					}
				}
			});

			// 更新大图为当前 active 缩略图，并同步缩略图 data-link 到大图 a 标签
			function updateTopicMainImg(index) {
				var $img = $thumbs.eq(index).find('img');
				var src = $img.attr('src');
				var alt = $img.attr('alt') || '';
				var link = $img.attr('data-link');
				if (!src) return;
				var $banner = $('.topics-main-img .placeholder-banner');
				var $mainImg = $('<img>').attr('src', src).attr('alt', alt);
				$banner.empty();
				if (link) {
					$banner.append($('<a>').attr('href', link).addClass('main-img-link').attr('name', alt).append($mainImg));
				} else {
					$banner.append($mainImg);
				}
			}

			// 设置激活缩略图（数量少、Swiper 锁定无法滑动时也能生效）
			function setTopicActive(index, scrollSwiper) {
				if (!$thumbs.length) return;
				topicIndex = (index + $thumbs.length) % $thumbs.length;
				$thumbs.removeClass('active').eq(topicIndex).addClass('active');
				updateTopicMainImg(topicIndex);
				if (scrollSwiper !== false) {
					thumbsSwiper.slideTo(topicIndex);
				}
			}

			// 自定义定时器自动轮播，不受 Swiper 锁定影响
			function startTopicAutoplay() {
				stopTopicAutoplay();
				if ($thumbs.length < 2) return;
				topicTimer = setInterval(function () {
					setTopicActive(topicIndex + 1);
				}, 5000);
			}
			function stopTopicAutoplay() {
				if (topicTimer) {
					clearInterval(topicTimer);
					topicTimer = null;
				}
			}

			// 初始化
			setTopicActive(0, false);
			startTopicAutoplay();

			// 点击缩略图切换为active，并重置计时
			$('.thumbsSwiper').on('click', '.swiper-slide', function () {
				setTopicActive($(this).index());
				startTopicAutoplay();
			});
			// 点击箭头后重置计时
			$('.thumbsSwiper .swiper-button-prev, .thumbsSwiper .swiper-button-next').on('click', function () {
				startTopicAutoplay();
			});
			// hover 暂停，移开继续（覆盖大图与缩略图整个区域）
			$('.topics-banner').on('mouseenter', stopTopicAutoplay).on('mouseleave', startTopicAutoplay);
			$('.market-tabs li').click(function () {
				let index = $(this).index();
				$(this).addClass('active').siblings().removeClass('active');
				$('.market-content').eq(index).addClass('active').siblings().removeClass('active');
			})
			$('.insights-categories .category-item').click(function () {
				let index = $(this).index();
				$(this).addClass('active').siblings().removeClass('active');
				$('.insights-right-content').eq(index).addClass('active').siblings().removeClass('active');
			})
		})
	</script>
